torrent-api.example.com {

    encode zstd gzip

    reverse_proxy 127.0.0.1:8090 {

        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

    }

    request_body {
        max_size 10MB
    }
}
